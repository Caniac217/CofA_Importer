<Window x:Class="CofA_Importer.LogPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Log File?" Height="150" Width="300" WindowStartupLocation="CenterOwner" Icon="/log-file-icon.png" ResizeMode="NoResize">
    <StackPanel Margin="10">
        <TextBlock Text="Would you like to open the log file for review?" Margin="0,0,0,10" />
        <CheckBox x:Name="chkDontAskAgain" Content="Don't ask me again" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="75" Margin="0,15,10,0" Click="Yes_Click">Yes</Button>
            <Button Width="75" Margin="0,15,10,0" Click="No_Click">No</Button>
        </StackPanel>
    </StackPanel>
</Window>
