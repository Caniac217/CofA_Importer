<Window x:Class="CofA_Importer.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="330" Width="400" SizeToContent="Height" MinWidth="400"
        WindowStartupLocation="CenterScreen" Icon="/settings_icon.png">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Test Connection must be successful before you can select a database." 
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Label Content="Server IP:"/>
            <TextBox x:Name="ServerIpTextBox" Width="Auto"/>

            <Label Content="Username:"/>
            <TextBox x:Name="UsernameTextBox" Width="Auto"/>

            <Label Content="Password:"/>
            <PasswordBox x:Name="PasswordBox" Width="Auto"/>

            <Label Content="Database:"/>

            <!-- ComboBox + Test Connection in a Grid -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DatabaseComboBox" Grid.Column="0" MinWidth="200" Margin="0,0,10,0"/>
                <Button Content="Test Connection" Grid.Column="1" Width="120" Click="TestConnection_Click"/>
            </Grid>

            <Label Content="Cofa Path:"/>

            <!-- TextBox + Browse in a Grid -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CofaPathTextBox" Grid.Column="0" Margin="0,0,10,0"/>
                <Button Content="Browse..." Grid.Column="1" Width="75" Click="BrowseCofaPath_Click"/>
            </Grid>

            <!-- Save Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save Settings" Click="SaveSettings_Click" Width="120"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
